# Alpaca market-data credentials.
# Do NOT commit your real keys.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# "iex" works with the basic/free market-data entitlement.
# Use "sip" only if your Alpaca subscription permits it.
ALPACA_DATA_FEED=iex

# Data window for the Qlib function test.
START_DATE=2020-01-01
END_DATE=

# Batch size for Alpaca requests.
ALPACA_BATCH_SIZE=25

# Where to build the Qlib binary dataset.
QLIB_DATA_DIR=~/.qlib/qlib_data/us_sp500_alpaca

# Local clone used only for scripts/dump_bin.py.
QLIB_REPO=.cache/qlib
